APP_ENV=development
APP_NAME=my-spends-api
API_PREFIX=/api/v1

# Supabase Dashboard -> Connect -> Session pooler (port 5432) is the safest
# choice for a persistent FastAPI process on an IPv4 network.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Settings -> API Keys -> Publishable and secret API keys.
# Publishable key będzie potrzebny frontendowi, ale backend go nie wymaga.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_STORAGE_BUCKET=receipts

# Only for local development without a frontend login.
AUTH_DISABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

MAX_UPLOAD_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local receipt understanding. Qwen3-VL requires Ollama 0.12.7 or newer.
RECEIPT_AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Address used only when the API runs in Docker Compose. Leave unchanged on Linux/macOS/Windows.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# Linux only: address of the Docker bridge used by the private Ollama proxy.
OLLAMA_BRIDGE_ADDRESS=172.17.0.1
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT_SECONDS=300
RECEIPT_AUTO_COMPLETE_CONFIDENCE=0.70
